# Copiar a `.env` (local, nunca compartir). La API key solo la usa el backend.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BOARD_SIZE=6
WIN_LENGTH=4
MAX_ROUNDS=3
TACTICAL_HINTS=true
# Horizonte del análisis táctico en medias jugadas (plies): 0 = desactivado, máx. 6.
# 4 = máquina, humano, máquina, humano. Es solo una ayuda: la jugada la negocian los agentes.
TACTICAL_LOOKAHEAD_PLIES=4
LLM_MOCK=true
CORS_ORIGINS=http://localhost:5173
# URL del backend vista desde el navegador (se fija al construir el frontend)
VITE_API_URL=http://localhost:8000
